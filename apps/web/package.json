    "test:e2e": "echo \"No web e2e tests yet\""
  },
  "dependencies": {
    "@guidora/contracts": "workspace:*",
    "@guidora/ui": "workspace:*",
    "next": "^15.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.7"
  }
}

{
  "name": "@guidora/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "pnpm --filter @guidora/contracts build && pnpm --filter @guidora/ui build && next build",
    "start": "next start --port 3000",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",

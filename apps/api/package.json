{
  "name": "@eudora/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts --port 5000",
    "lint": "eslint .",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "openapi:generate": "tsx src/generate-openapi.ts"
  },
  "dependencies": {
    "@eudora/db": "workspace:*",
    "@nestjs/common": "11.1.21",
    "@nestjs/core": "11.1.21",
    "@nestjs/platform-express": "11.1.21",
    "@nestjs/swagger": "11.4.3",
    "dotenv": "17.2.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.21",
    "@types/node": "24.10.2",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "3.2.4"
  }
}
